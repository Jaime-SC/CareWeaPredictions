# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env*.local

# allow the example env template
!.env.example

# prisma local sqlite
/prisma/*.db
/prisma/*.db-journal
/dev.db
/dev.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cursor: ignore local IDE state; keep shared project rules (Ponytail)
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# local agent helpers (Next regenerates AGENTS.md; Claude uses CLAUDE.md)
AGENTS.md
CLAUDE.md

# internal audit / planning artifacts (not for public repo)
CAREWEAPREDICTIONS_*.md

# python
__pycache__/
*.py[cod]
