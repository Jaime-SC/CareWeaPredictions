# Neon PostgreSQL
# 1. Crea un proyecto en https://console.neon.tech (plan Free).
# 2. Dashboard → Connect → elige "Prisma" / copia pooled + direct.
# 3. Pega las mismas dos URLs en `.env` y `.env.local` (trabajo y casa).
#
# Prisma CLI lee `.env`. Next.js carga `.env` y `.env.local` (este último pisa al primero).

# Pooled (el host incluye `-pooler`). La usa la app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Directa (sin `-pooler`). La usan `prisma migrate` y `prisma db push`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# API-Football (secretos en `.env.local`)
# FOOTBALL_API_KEY=

# Opcional: multi-source enrichment (lib/sources/*)
# ODDS_API_KEY=          # The Odds API — fill-gaps only
# FOOTBALL_DATA_API_KEY= # Football-Data.org — /api/backtest

# Opcional: cron de liquidación y tope diario de llamadas
# CRON_SECRET=
# API_FOOTBALL_DAILY_LIMIT=100

# Opcional: AI Judge (Gemini + Google Search Grounding). Sin clave, el ticket no se audita.
# GEMINI_API_KEY=
