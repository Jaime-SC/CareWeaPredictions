# =============================================================================
# CareWeaPredictions — plantilla de variables de entorno
# Copia a `.env` (Prisma CLI) y `.env.local` (Next.js; pisa `.env`).
# Nunca subas archivos con credenciales reales.
# =============================================================================

# --- Neon PostgreSQL (requerido) ---------------------------------------------
# 1. Crea un proyecto en https://console.neon.tech (plan Free).
# 2. Dashboard → Connect → elige "Prisma" y copia pooled + direct.

# Pooled (host con `-pooler`) — la usa la app en runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Directa (sin `-pooler`) — `prisma migrate` / `db push` (TCP 5432).
# Si 5432 está bloqueado: npm run db:migrate:http
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- API-Football (requerido para datos live) --------------------------------
# https://www.api-football.com/
FOOTBALL_API_KEY=your_api_football_key_here

# --- Vercel Cron / seguridad de mutaciones (requerido en producción) ---------
# Bearer token para /api/cron/settle y rutas POST sensibles.
CRON_SECRET=your_cron_secret_here

# --- AI Judge — Groq Llama (opcional) ----------------------------------------
# Sin clave, los picks no pasan auditoría IA (el resto del flujo funciona).
GROQ_API_KEY=your_groq_api_key_here
# Modelo primario (fallback automático si 404):
# GROQ_MODEL=llama-3.3-70b-versatile
# Tope diario local del badge (RPD free ≈ 14400):
# GROQ_DAILY_LIMIT=14400

# --- Enriquecimiento multi-fuente (opcional) ---------------------------------
# The Odds API — relleno de cuotas faltantes (lib/sources/*)
# ODDS_API_KEY=your_odds_api_key_here

# Football-Data.org — backtest histórico (/api/backtest)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# --- Cuotas API-Football (opcional) ------------------------------------------
# Tope diario local del badge. Plan de pago ≈ 7500.
# API_FOOTBALL_DAILY_LIMIT=7500
