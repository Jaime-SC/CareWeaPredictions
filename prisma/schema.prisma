generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Fixture snapshot for analytics & result reconciliation
model MatchFixture {
  id           String   @id @default(cuid())
  apiFixtureId Int      @unique
  homeTeam     String
  awayTeam     String
  leagueId     String
  leagueName   String
  matchDate    DateTime
  finalScore   String?
  status       String   @default("NS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  predictions Prediction[]

  @@index([leagueId])
  @@index([matchDate])
  @@index([status])
  @@index([createdAt])
}

/// Individual model pick (leg) linked to a fixture and optional ticket
model Prediction {
  id               String   @id @default(cuid())
  fixtureId        String
  ticketId         String?
  market           String
  selection        String
  odds             Float
  modelProbability Float
  /// Book line captured at pick time is `odds`. Closing line (pre-kickoff).
  closingOdds      Float?
  closingOddsAt    DateTime?
  /// WON | LOST | PENDING | VOID
  outcome          String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fixture MatchFixture       @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  ticket  AccumulatorTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([outcome])
  @@index([market])
  @@index([fixtureId])
  @@index([createdAt])
}

/// Accumulator or single-pick ticket
model AccumulatorTicket {
  id        String   @id @default(cuid())
  date      String
  mode      String
  stakeCLP  Float
  totalOdds Float
  payoutCLP Float
  /// PENDING | WON | LOST | VOID
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]

  @@index([date])
  @@index([mode])
  @@index([status])
  @@index([createdAt])
}

/// Persistent HTTP cache for API-Football responses (quota saver)
model CachedApiResponse {
  /// Stable key e.g. fixtures_date_2026-08-12 or fixtures_ids_123-456
  id        String   @id
  endpoint  String
  payload   String
  /// Far-future date = permanent (finished fixtures)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpoint])
  @@index([expiresAt])
}

/// Official API-Football daily quota mirrored from response headers
model ApiQuotaDaily {
  /// YYYY-MM-DD (Chile)
  date       String   @id
  /// Official used (= limit - remaining)
  callCount  Int      @default(0)
  /// x-ratelimit-requests-limit
  limit      Int      @default(100)
  /// x-ratelimit-requests-remaining
  remaining  Int      @default(100)
  /// True only after values were written from live response headers
  fromHeaders Boolean @default(false)
  updatedAt  DateTime @updatedAt
}

/// Single-tenant bankroll (id = "default")
model BankrollSettings {
  id                String   @id
  totalBankroll     Float
  currency          String   @default("CLP")
  minBookmakerStake Float
  maxRiskSingle     Float
  maxRiskParlay     Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Rolling team stats from finished MatchFixture history (local calibration)
model TeamProfile {
  id                   String   @id @default(cuid())
  /// API-Football team id
  teamId               Int      @unique
  teamName             String
  totalMatchesAnalyzed Int      @default(0)
  /// Settled samples in rolling window as home / away
  homeMatchesCount     Int      @default(0)
  awayMatchesCount     Int      @default(0)
  avgGoalsScoredHome   Float    @default(0)
  avgGoalsConcededHome Float    @default(0)
  avgGoalsScoredAway   Float    @default(0)
  avgGoalsConcededAway Float    @default(0)
  /// Fraction 0–1 of analyzed matches with total goals > 1.5
  over15GoalsRate      Float    @default(0)
  over15GoalsRateHome  Float    @default(0)
  over15GoalsRateAway  Float    @default(0)
  /// Fraction 0–1 of analyzed matches with total goals > 2.5
  over25GoalsRate      Float    @default(0)
  /// Fraction 0–1 of analyzed matches where this team conceded 0
  cleanSheetRate       Float    @default(0)
  cleanSheetRateHome   Float    @default(0)
  cleanSheetRateAway   Float    @default(0)
  /// When set, profiler ignores matches before this date (manager reset)
  lastManagerChangeDate DateTime?
  /// Key attacking-line absences known for this team (λ dampener)
  keyAbsencesCount     Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@index([teamName])
}
