generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Fixture snapshot for analytics & result reconciliation
model MatchFixture {
  id           String   @id @default(cuid())
  apiFixtureId Int      @unique
  homeTeam     String
  awayTeam     String
  leagueId     String
  leagueName   String
  matchDate    DateTime
  finalScore   String?
  status       String   @default("NS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  predictions Prediction[]

  @@index([leagueId])
  @@index([matchDate])
  @@index([status])
  @@index([createdAt])
}

/// Individual model pick (leg) linked to a fixture and optional ticket
model Prediction {
  id               String   @id @default(cuid())
  fixtureId        String
  ticketId         String?
  market           String
  selection        String
  odds             Float
  modelProbability Float
  /// Book line captured at pick time is `odds`. Closing line (pre-kickoff).
  closingOdds      Float?
  closingOddsAt    DateTime?
  /// WON | LOST | PENDING | VOID
  outcome          String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fixture MatchFixture       @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  ticket  AccumulatorTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([outcome])
  @@index([market])
  @@index([fixtureId])
  @@index([createdAt])
}

/// Accumulator or single-pick ticket
model AccumulatorTicket {
  id        String   @id @default(cuid())
  date      String
  mode      String
  stakeCLP  Float
  totalOdds Float
  payoutCLP Float
  /// PENDING | WON | LOST | VOID
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]

  @@index([date])
  @@index([mode])
  @@index([status])
  @@index([createdAt])
}

/// Persistent HTTP cache for API-Football responses (quota saver)
model CachedApiResponse {
  /// Stable key e.g. fixtures_date_2026-08-12 or fixtures_ids_123-456
  id        String   @id
  endpoint  String
  payload   String
  /// Far-future date = permanent (finished fixtures)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpoint])
  @@index([expiresAt])
}

/// Official API-Football daily quota mirrored from response headers
model ApiQuotaDaily {
  /// YYYY-MM-DD (Chile)
  date       String   @id
  /// Official used (= limit - remaining)
  callCount  Int      @default(0)
  /// x-ratelimit-requests-limit
  limit      Int      @default(100)
  /// x-ratelimit-requests-remaining
  remaining  Int      @default(100)
  /// True only after values were written from live response headers
  fromHeaders Boolean @default(false)
  updatedAt  DateTime @updatedAt
}
